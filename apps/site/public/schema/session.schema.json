{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openroom.app/schema/session.schema.json",
  "title": "Outline interactions",
  "description": "Shared interaction, defaults, and Q&A definitions for Outline v1. Not a standalone document — Outline v1 $refs these defs, and a live session runs the outline stored on the deck.",
  "type": "object",
  "required": ["version", "meta", "interactions"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "description": "Session format version. Only 1 exists."
    },
    "meta": { "$ref": "#/$defs/meta" },
    "defaults": { "$ref": "#/$defs/defaults" },
    "qna": { "$ref": "#/$defs/qna" },
    "interactions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/interaction" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case stable identifier, 1-64 chars."
    },
    "display": {
      "type": "string",
      "description": "Stage rendering style. Allowed values are per-interaction-type; mismatches are reported as E_DISPLAY_MISMATCH by the validator.",
      "enum": [
        "bars",
        "columns",
        "donut",
        "pie",
        "radial",
        "emoji-pulse",
        "dots",
        "gauge",
        "histogram",
        "list",
        "word-cloud",
        "ordered-bars",
        "sentence",
        "gaps",
        "bank",
        "choices",
        "pairs",
        "number",
        "tally",
        "wordcloud",
        "scale",
        "rank",
        "emoji",
        "cards"
      ]
    },
    "displayOptions": {
      "type": "object",
      "description": "Chart attributes for the selected display. Irrelevant keys are stripped on normalize; invalid types fail validation.",
      "additionalProperties": false,
      "properties": {
        "orientation": { "type": "string", "enum": ["horizontal", "vertical"] },
        "showPercent": { "type": "boolean" },
        "showCount": { "type": "boolean" },
        "sortBy": { "type": "string", "enum": ["order", "votes", "label"] },
        "colorMode": { "type": "string", "enum": ["series", "mono"] },
        "innerHole": { "type": "number", "minimum": 0, "maximum": 0.85 },
        "showMean": { "type": "boolean" },
        "showMedian": { "type": "boolean" },
        "showAvgRank": { "type": "boolean" },
        "binCount": { "type": "integer", "minimum": 3, "maximum": 24 },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxWords": { "type": "integer", "minimum": 5, "maximum": 80 },
        "minWordLength": { "type": "integer", "minimum": 2, "maximum": 12 }
      }
    },
    "resultVisibility": {
      "type": "string",
      "enum": ["hidden-until-close", "live"]
    },
    "theme": {
      "type": "string",
      "description": "Built-in @openroom/ui theme id used by the participant, stage and host surfaces. The host can override it live with the room.theme command.",
      "enum": ["default", "chalkboard", "paper", "projector", "sherbet"]
    },
    "meta": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})?$",
          "description": "BCP-47-ish language tag, e.g. 'en' or 'en-GB'."
        },
        "source": { "type": "string", "maxLength": 500 }
      }
    },
    "qna": {
      "type": "object",
      "description": "Session-wide audience Q&A: participants ask and upvote questions for the whole session, independent of any interaction.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 300,
          "description": "Maximum question length in characters."
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identityMode": { "type": "string", "enum": ["anonymous", "pseudonymous", "identified", "roster"] },
        "resultVisibility": { "$ref": "#/$defs/resultVisibility" },
        "allowAnswerChange": { "type": "boolean" },
        "theme": { "$ref": "#/$defs/theme" }
      }
    },
    "pedagogy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective": { "type": "string", "maxLength": 500 },
        "explanation": { "type": "string", "maxLength": 2000 },
        "followUp": { "type": "string", "maxLength": 1000 },
        "durationSec": { "type": "integer", "minimum": 1, "maximum": 7200 }
      }
    },
    "option": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 300 },
        "correct": { "type": "boolean" },
        "misconception": { "type": "string", "maxLength": 300 }
      }
    },
    "rankingOption": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "description": "A ranking option. Per-option correctness is not allowed; optional interaction-level correctOrder scores a full permutation.",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "interaction": {
      "type": "object",
      "required": ["id", "type", "prompt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "type": "string",
          "enum": ["choice", "scale", "numeric", "text", "qna", "ranking", "fill-the-gaps", "match"]
        },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 500 },
        "display": { "$ref": "#/$defs/display" },
        "displayOptions": { "$ref": "#/$defs/displayOptions" },
        "resultVisibility": { "$ref": "#/$defs/resultVisibility" },
        "allowAnswerChange": { "type": "boolean" },
        "allowDontKnow": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 2000 },
        "pedagogy": { "$ref": "#/$defs/pedagogy" },
        "timerSec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200,
          "description": "Optional live countdown in seconds. When set, opening the interaction arms a closesAt advisory window. Zero never closes answering; the teacher closes."
        },
        "peerInstruction": {
          "type": "boolean",
          "description": "Peer instruction cycle (vote, discuss, revote). Only valid on a single-select choice interaction; other placements are reported as E_PEER_INSTRUCTION_CONFIG by the validator."
        }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "choice" } } },
          "then": {
            "required": ["options"],
            "properties": {
              "options": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/option" }
              },
              "multiple": { "type": "boolean" }
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "scale" } } },
          "then": {
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "integer", "minimum": -1000, "maximum": 1000 },
              "max": { "type": "integer", "minimum": -1000, "maximum": 1000 },
              "minLabel": { "type": "string", "maxLength": 100 },
              "maxLabel": { "type": "string", "maxLength": 100 }
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "numeric" } } },
          "then": {
            "properties": {
              "unit": { "type": "string", "maxLength": 40 },
              "correct": { "type": "number" },
              "tolerance": { "type": "number", "minimum": 0 }
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "text" } } },
          "then": {
            "properties": {
              "maxLength": { "type": "integer", "minimum": 1, "maximum": 500 },
              "correctAnswers": {
                "type": "array",
                "description": "Accepted short-text answers for quiz-style reveal. Matching uses locale fold plus optional accent/punctuation rules. Stripped from participant/stage views until reveal.",
                "minItems": 1,
                "maxItems": 20,
                "items": { "type": "string", "minLength": 1, "maxLength": 500 }
              },
              "match": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "locale": { "type": "string", "minLength": 2, "maxLength": 32 },
                  "accents": { "type": "string", "enum": ["require", "ignore"] },
                  "punctuation": { "type": "string", "enum": ["keep", "strip"] }
                }
              }
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "qna" } } },
          "then": { "properties": {} }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "ranking" } } },
          "then": {
            "required": ["options"],
            "properties": {
              "options": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/rankingOption" }
              },
              "correctOrder": {
                "type": "array",
                "description": "Optional correct permutation of option ids (best first). Preference ranking still uses Borda; this is reveal/scoring metadata only. Stripped until reveal. Must be a complete permutation of options (semantic E_CORRECT_ORDER).",
                "minItems": 2,
                "maxItems": 6,
                "items": { "$ref": "#/$defs/id" }
              }
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "fill-the-gaps" } } },
          "then": {
            "required": ["gaps"],
            "properties": {
              "gaps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": ["id", "answers"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "$ref": "#/$defs/id" },
                    "answers": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 20,
                      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
                    },
                    "distractors": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 12,
                      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
                    }
                  }
                }
              },
              "bank": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": { "type": "string", "minLength": 1, "maxLength": 200 }
              },
              "match": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "locale": { "type": "string", "minLength": 2, "maxLength": 32 },
                  "accents": { "type": "string", "enum": ["require", "ignore"] },
                  "punctuation": { "type": "string", "enum": ["keep", "strip"] }
                }
              }
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "match" } } },
          "then": {
            "required": ["left", "right", "correct"],
            "properties": {
              "left": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "items": { "$ref": "#/$defs/rankingOption" }
              },
              "right": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "items": { "$ref": "#/$defs/rankingOption" }
              },
              "correct": {
                "type": "object",
                "minProperties": 2,
                "maxProperties": 6,
                "additionalProperties": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
