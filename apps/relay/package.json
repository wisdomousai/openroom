{
  "name": "openroom-relay",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./live": "./src/live.ts",
    "./tokens": "./src/tokens.ts",
    "./join-url": "./src/join-url.ts",
    "./export": "./src/export.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "deploy": "node scripts/collect-assets.mjs && wrangler deploy",
    "build": "node scripts/collect-assets.mjs",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openroom/domain": "workspace:*",
    "@openroom/schema": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.119.0",
    "yaml": "^2.6.1"
  }
}
