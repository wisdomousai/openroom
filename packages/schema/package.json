{
  "name": "@openroom/schema",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./schema/session.schema.json": "./schema/session.schema.json",
    "./schema/outline.schema.json": "./schema/outline.schema.json",
    "./schema/draft-session.schema.json": "./schema/draft-session.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "generate": "node scripts/compile-validator.mjs",
    "build": "bun run generate && tsc -p tsconfig.json && mkdir -p dist/src/generated && cp src/generated/*.js dist/src/generated/",
    "test": "bun run generate && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
