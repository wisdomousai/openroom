{
  "version": 1,
  "meta": {
    "title": "Walkthrough Q&A session",
    "description": "A Q&A-enabled session used by the narrated walkthrough.",
    "locale": "en"
  },
  "defaults": {
    "identityMode": "pseudonymous",
    "resultVisibility": "hidden-until-close",
    "allowAnswerChange": true
  },
  "qna": {
    "enabled": true,
    "maxLength": 300
  },
  "interactions": [
    {
      "id": "qna-warmup",
      "type": "choice",
      "prompt": "What should participants see during a live session?",
      "display": "bars",
      "options": [
        { "id": "live-question", "label": "The live question", "correct": true },
        { "id": "private-notes", "label": "Private host notes" }
      ]
    }
  ]
}
