# Copy to .env.local. This file is intentionally safe to commit.
# The real .env.local is ignored by git.

OPENROOM_URL=http://127.0.0.1:8787
OPENROOM_ADMIN_KEY=dev-admin
WALKTHROUGH_OUTPUT_DIR=docs/walkthrough/output
WALKTHROUGH_HEADED=0

MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=Milo
MIMO_TTS_STYLE=Warm, specific product guide. Speak like an experienced colleague walking through the real workflow. Calm, natural, and concrete. Avoid sales language, trailer voice, and exaggerated enthusiasm.
MIMO_TTS_TIMEOUT=180
